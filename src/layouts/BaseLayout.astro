---
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props { 
  title?: string;
  checkAuth?: boolean;
}
const { 
  title = 'Product Inventory Management',
  checkAuth = true 
} = Astro.props;

// Get authentication state for conditional rendering
const currentPath = Astro.url.pathname;
const isLoginPage = currentPath === '/login';
const isAuthenticated = Astro.cookies.has('auth_token');

// Note: Auth redirects should be handled in the page components, not in the layout
---

<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <!-- Import Tailwind CSS via Astro's import system -->
    <style global>
      @import '../styles.css';
    </style>
    <script is:inline>
      // Initialize theme from localStorage or system preference
      const theme = localStorage.getItem('theme') || 
                   (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.classList.toggle('dark', theme === 'dark');
    </script>
  </head>
  <body class="h-full font-sans bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-white transition-colors duration-200">
    <header class="p-4 border-b border-slate-200 dark:border-white/10 shadow-sm">
      <div class="max-w-7xl mx-auto flex items-center justify-between">
        <h1 class="text-xl font-semibold tracking-tight flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary-400"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect><path d="M16 16h.01"></path><path d="M8 16h.01"></path><path d="M8 8h.01"></path><path d="M16 8h.01"></path></svg>
          <span>Product <span class="text-primary-400">Inventory</span></span>
        </h1>
        <div class="flex items-center gap-4">
          <ThemeToggle />
          {isAuthenticated && !isLoginPage && (
            <form method="POST" action="/api/logout">
              <button type="submit" class="text-sm text-slate-600 dark:text-slate-400 hover:text-primary-500 dark:hover:text-primary-400">
                Logout
              </button>
            </form>
          )}
        </div>
      </div>
    </header>
    <main class="max-w-7xl mx-auto px-4 py-6">
      <slot />
    </main>
    <footer class="text-center text-xs text-slate-500 dark:text-slate-500 pb-6">Product Inventory Management System</footer>
  </body>
</html>
